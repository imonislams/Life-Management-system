APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AI Layer (Personal Workspace AI + RAG + Vector Search)
# ---------------------------------------------------------------------------
# The AI assistant is OPTIONAL and 100% local. No paid AI API or API key is
# ever required. See AI_LOCAL_SETUP.md for the installation walkthrough.
AI_ENABLED=false
# Provider selection: ollama (local, default) | null (deterministic offline)
AI_PROVIDER=ollama
AI_TIMEOUT=120
# --- Local LLM runtime (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# "auto" = pick a sensible installed model for the detected hardware.
OLLAMA_MODEL=auto
OLLAMA_EMBEDDING_MODEL=auto
OLLAMA_EMBEDDING_TIMEOUT=60
OLLAMA_KEEP_ALIVE=5m
AI_AUTO_SELECT_MODEL=true
# --- Vector database (self-hosted Qdrant; no paid account) ---
AI_VECTOR_DRIVER=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=life_management
QDRANT_TIMEOUT=5
QDRANT_DISTANCE=Cosine
QDRANT_MIRROR_DATABASE=true
# Retrieval + usage limits
AI_TOP_K=8
AI_MAX_CONTEXT_ITEMS=20
AI_RETRIEVAL_MIN_SCORE=0.15
AI_MAX_CONTEXT_CHARS=12000
AI_STRUCTURED_ROW_LIMIT=50
AI_MAX_QUESTION_CHARS=2000
AI_MAX_RESPONSE_CHARS=8000
AI_RATE_LIMIT_PER_MINUTE=20
AI_HISTORY_MESSAGES=6
# Embedding sync (queue jobs; synchronous fallback is opt-in)
AI_SYNC_QUEUE=true
AI_SYNC_SYNCHRONOUS=false
AI_QUEUE_NAME=default
# Privacy + future fine-tuning scaffolding (sampling is opt-in, off by default)
AI_REDACT_EMAIL=true
AI_MAX_RECORDS_PER_SOURCE=25
AI_COLLECT_TRAINING_SAMPLES=false
